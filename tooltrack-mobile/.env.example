# Development Android emulators use http://10.0.2.2:8080 automatically.
# Production must use an HTTPS URL reachable from real devices.
EXPO_PUBLIC_API_URL=https://api.your-domain.example
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy
EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://your-domain.example/delete-account
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
